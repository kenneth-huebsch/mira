{
  "schema_version": 2,
  "adapter": {
    "contract_version": 2,
    "runtime_repos": "/home/node/.openclaw/workspace/runtime/repos",
    "runs_dir": "/home/node/.openclaw/workspace/runtime/coding-harness-runs",
    "denied_roots": [
      "/home/kenny/mira",
      "/home/node/.openclaw",
      "/home/node/.openclaw/workspace",
      "/home/node/.openclaw/workspace/runtime/repos/agent"
    ]
  },
  "allowed_target_roots": [
    "/home/node/.openclaw/workspace/runtime/repos"
  ],
  "inherited_environment_keys": [
    "HOME",
    "LANG",
    "LC_ALL",
    "LOGNAME",
    "PATH",
    "SHELL",
    "TERM",
    "TMPDIR",
    "TZ",
    "USER",
    "XDG_CONFIG_HOME"
  ],
  "capability_environment": {
    "aws": [
      "AWS_CONFIG_FILE",
      "AWS_PROFILE",
      "AWS_REGION",
      "AWS_DEFAULT_REGION",
      "AWS_SHARED_CREDENTIALS_FILE"
    ],
    "browser": [
      "PLAYWRIGHT_CLI_BIN"
    ]
  },
  "capability_verification_hints": {
    "aws": ["synth", "cdk", "aws"]
  },
  "sensitive_path_patterns": [
    "(^|/)(\\.env($|\\.)|[^/]*\\.env$|credentials?($|[./])|secrets?($|[./]))",
    "\\.(pem|key|p12|pfx)$"
  ],
  "default_timeout_seconds": 3000,
  "cancellation_grace_seconds": 15,
  "allow_shell_verification": false,
  "model_tiers": {
    "cheap": {
      "implement": "composer-2.5-fast",
      "review": "composer-2.5-fast",
      "fix": "composer-2.5-fast"
    },
    "default": {
      "implement": "composer-2.5",
      "review": "cursor-grok-4.5-high",
      "fix": "composer-2.5"
    },
    "reasoning": {
      "implement": "cursor-grok-4.5-high",
      "review": "cursor-grok-4.5-high",
      "fix": "cursor-grok-4.5-high"
    }
  },
  "cheap_task_classes": [
    "mechanical",
    "formatting",
    "boilerplate"
  ],
  "cheap_no_review_task_classes": [
    "mechanical",
    "formatting"
  ],
  "default_branches": [
    "main",
    "master"
  ],
  "guarded_commands": [
    "git commit",
    "git push",
    "git reset --hard",
    "git clean -f",
    "gh pr create",
    "gh pr merge",
    "gh pr review",
    "npm publish",
    "pnpm publish",
    "yarn publish",
    "python -m twine upload",
    "twine upload",
    "kubectl apply",
    "kubectl delete",
    "helm install",
    "helm upgrade",
    "terraform apply",
    "terraform destroy",
    "docker push"
  ]
}
